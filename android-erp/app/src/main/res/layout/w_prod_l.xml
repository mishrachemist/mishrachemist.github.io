<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/w_bg" android:padding="14dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
  <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_stat_moltrix" />
  <TextView android:id="@+id/p_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:text="Production" android:textSize="12sp" android:textColor="#FFA9B6CC" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
  <TextView android:id="@+id/p_sync" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="11sp" android:textColor="#FFA9B6CC" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="bottom" android:layout_marginTop="8dp">
  <TextView android:id="@+id/p_mt" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="–" android:textSize="34sp" android:textColor="#FFFFFFFF" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
  <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="12dp" android:paddingBottom="4dp">
    <TextView android:id="@+id/p_sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MT billet today" android:textSize="12sp" android:textColor="#FFE8ECF4" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/p_sub2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="12sp" android:textColor="#FFA9B6CC" android:maxLines="1" android:ellipsize="end" />
  </LinearLayout>
</LinearLayout>
<ImageView android:id="@+id/p_bars" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="8dp" android:scaleType="fitXY" />
<TextView android:id="@+id/p_foot" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="11sp" android:textColor="#FFA9B6CC" android:maxLines="1" android:ellipsize="end"  android:layout_marginTop="6dp"/>
</LinearLayout>

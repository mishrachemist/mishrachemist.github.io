<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- tap vibration of the Moltrix page (navigator.vibrate works in the WebView only with this) -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- keep running with the screen locked / another app in front -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- F&O gamma watch: wake at 10:58 on weekdays (exact alarm = allowed to start the watch) and again after a restart -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="Moltrix"
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:usesCleartextTraffic="true">

        <!-- Moltrix -->
        <activity
            android:name=".MoltrixActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:exported="true"
            android:label="Moltrix"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- files Moltrix shares (WhatsApp etc.) / saves on Android 8-9 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- ERP part: opened by Moltrix's 📲 buttons (or long-press the icon → ERP); its own entry in Recents -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="true"
            android:label="Moltrix ERP"
            android:launchMode="singleTask"
            android:taskAffinity="com.mishrachemist.moltrixerp.erp"
            android:windowSoftInputMode="adjustResize">
            <!-- Moltrix opens  intent://run#Intent;scheme=moltrixerp;...;S.payload=<json>;end -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="moltrixerp" />
            </intent-filter>
        </activity>

        <!-- F&O: expiry-day gamma watch -->
        <service
            android:name=".GammaService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <service
            android:name=".ScrService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <receiver
            android:name=".ScrAlarm"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".GammaAlarm"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- home-screen widgets -->
        <receiver
            android:name=".ProdWidget"
            android:exported="false"
            android:label="Moltrix Production">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/w_prod_info" />
        </receiver>
        <receiver
            android:name=".MarketWidget"
            android:exported="false"
            android:label="Moltrix Market">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/w_mkt_info" />
        </receiver>
        <receiver
            android:name=".QuickWidget"
            android:exported="false"
            android:label="Moltrix Quick">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/w_quick_info" />
        </receiver>

        <!-- WhatsApp capture (28-Nov-2026): sends WhatsApp notifications to the Inbox Apps Script - instead of MacroDroid -->
        <service
            android:name=".WaCapture"
            android:exported="true"
            android:label="Moltrix WhatsApp capture"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <service
            android:name=".RunService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
